# Copia este archivo como ".env" (en la carpeta backend) y completa los valores.
# El archivo ".env" real no se versiona ni se comparte.

APP_ENV=local
APP_TZ=America/Lima

# Orígenes del frontend autorizados por CORS (separados por comas)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Sesión (cookie JATSA_SESION)
SESSION_HORAS=8
SESSION_DIAS_RECORDAR=14
# true cuando la aplicación se sirva por HTTPS
SESSION_SECURE=false

# SQL Server
DB_HOST=localhost
# Dejar vacío si se usa el puerto por defecto o una instancia por defecto
DB_PORT=
# Nombre de la base de datos (obligatorio para conectar)
DB_NAME=
# Dejar DB_USER y DB_PASSWORD vacíos para usar autenticación de Windows
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_CERT=true

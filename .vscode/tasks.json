{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend (PHP :8000)",
      "type": "process",
      "command": "C:\\php\\php.exe",
      "args": ["-S", "localhost:8000", "-t", "backend/public"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "jatsa" }
    },
    {
      "label": "Frontend (Vite :5173)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "jatsa" }
    },
    {
      "label": "Iniciar JATSA (backend + frontend)",
      "dependsOn": ["Backend (PHP :8000)", "Frontend (Vite :5173)"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
